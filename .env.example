# Production settings for AutoMarket.al.
# Django does NOT read this file by itself: set these as real environment variables
# on your host (or load them with your process manager). Never commit a real .env.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=automarket.al,www.automarket.al
DJANGO_CSRF_TRUSTED_ORIGINS=https://automarket.al,https://www.automarket.al
DJANGO_MEDIA_ROOT=/var/www/automarket/media

# PostgreSQL (leave DB_ENGINE unset to use SQLite in development)
DB_ENGINE=postgres
DB_NAME=automarket
DB_USER=automarket
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Email (password reset). Default prints emails to the console.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@automarket.al

# Behind nginx or another reverse proxy? Set to 1 so rate limiting sees the real client IP
# (your proxy MUST set X-Forwarded-For; with 1 and no proxy, clients could spoof their IP).
DJANGO_BEHIND_PROXY=1
# Move the admin away from /admin/ (keep the trailing slash)
DJANGO_ADMIN_URL=panel-change-me/
# Shared cache for rate limiting when running several gunicorn workers (needs: pip install redis)
# REDIS_URL=redis://localhost:6379/1

# HSTS preload is hard to undo; enable only if the whole domain will always be HTTPS
# DJANGO_HSTS_PRELOAD=1
